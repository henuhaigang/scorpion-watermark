{
  "productName": "Scorpion Watermark",
  "version": "0.1.0",
  "identifier": "com.scorpion.watermark",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "title": "Scorpion Watermark",
      "width": 1280,
      "height": 800,
      "minWidth": 960,
      "minHeight": 640
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    }
  }
}
